platform :osx, '12'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  # VLCKit downloads from download.videolan.org (by choice since 3.7.4,
  # 2026-10-02). That host is the only place VideoLAN publishes these
  # frameworks -- no mirror carries /pub/cocoapods/, there are no upstream
  # GitHub release assets, and the SPM manifest points back at the same host
  # -- so when it went down on 2026-09-20 `pod install` died on
  # `curl (7) Failed to connect` and took the macOS build with it. A podspec
  # `source` accepts exactly one URL, so unlike
  # packages/vlc_player/windows/CMakeLists.txt there is no mirror list to fall
  # back to.
  #
  # 3.7.3 was served from a SkyStream release asset after that outage. If the
  # host fails again, do the same; the `description` field in
  # vendor/VLCKit.podspec.json has the steps. CocoaPods enforces the sha256
  # either way.
  pod 'VLCKit', :podspec => 'vendor/VLCKit.podspec.json'

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # No MACOSX_DEPLOYMENT_TARGET force here. It used to pin every pod to
    # 10.13, which was harmless only because every pod in the graph declared a
    # platform below 12 and podhelper then deleted the setting - the moment one
    # declares 12.0 or higher, forcing 10.13 breaks its build. The Runner is on
    # 12.0 and flutter_additional_macos_build_settings aligns pods to it.
    flutter_additional_macos_build_settings(target)
  end
end
